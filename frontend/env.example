# Configuration de l'API
# Décommentez et modifiez selon vos besoins

# Mode local (défaut)
# REACT_APP_API_URL=http://localhost:8000/api

# Mode production
# REACT_APP_API_URL=https://bachatavibe.com/api

# Mode développement avec serveur distant
# REACT_APP_API_URL=http://172.105.90.92:8000/api

# Note: Si aucune variable n'est définie, le système détecte automatiquement
# l'environnement basé sur l'URL du navigateur





